{
  "name": "agent-compiler",
  "version": "0.3.0",
  "description": "Compile deterministic, content-hashed agents from small behavior modules: a typed AgentQuery in, an immutable AgentImage and rendered harness-native subagent out; fails closed on conflicts.",
  "author": {
    "name": "Jordan Richlen"
  },
  "repository": "https://github.com/JRichlen/agent-plugins",
  "homepage": "https://github.com/JRichlen/agent-plugins/tree/main/plugins/agent-compiler",
  "license": "MIT",
  "keywords": [
    "agent-compiler",
    "behavior-modules",
    "deterministic",
    "provenance",
    "effect-ceiling",
    "agent-image",
    "persona"
  ],
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "kernel": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_server.py"
      ]
    }
  }
}
