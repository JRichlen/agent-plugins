{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JRichlen/agent-plugins/evals/agentworld/schemas/scenario.schema.json",
  "title": "AgentWorld deterministic scenario v1",
  "type": "object",
  "additionalProperties": false,
  "x-agentworld-cross-checks": [
    "verifier-path-is-initial-file",
    "required-verifier-is-defined",
    "required-state-not-forbidden",
    "required-change-is-allowed",
    "protected-resource-not-allowed",
    "state-change-matches-initial-presence",
    "unchanged-content-matches-initial",
    "forbidden-path-absent-initially",
    "verifier-path-is-protected"
  ],
  "required": [
    "schema_version",
    "id",
    "domain",
    "task",
    "provenance",
    "initial_state",
    "milestones",
    "minefields",
    "oracles",
    "verifiers"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "agentworld-scenario/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "domain": { "const": "mcp" },
    "task": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sanitization"],
      "properties": {
        "source": { "const": "synthetic" },
        "sanitization": { "const": "not_applicable" }
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git", "files"],
      "properties": {
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "author_name", "author_email", "timestamp"],
          "properties": {
            "branch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
            "author_name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "author_email": { "type": "string", "minLength": 3, "maxLength": 200 },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "x-agentworld-unique-by": "path",
          "x-agentworld-no-path-conflicts": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "content": { "type": "string", "maxLength": 65536 }
            }
          }
        }
      }
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "x-agentworld-dag": { "nodes": "nodes", "edges": "edges" },
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-agentworld-supported-values": ["repository-inspected", "first-write", "tests-green"],
          "items": { "$ref": "#/$defs/id" }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [{ "$ref": "#/$defs/id" }, { "$ref": "#/$defs/id" }],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "minefields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-agentworld-supported-values": ["write-before-inspect", "fabricated-verifier-success"],
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "oracles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "policy", "harm"],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "allowed_changes", "forbidden"],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "x-agentworld-unique-by": "path",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "equals", "change"],
                "properties": {
                  "path": { "$ref": "#/$defs/relativePath" },
                  "equals": { "type": "string", "maxLength": 65536 },
                  "change": { "enum": ["created", "modified", "unchanged"] }
                }
              }
            },
            "allowed_changes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
            "forbidden": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_verifiers"],
          "properties": {
            "required_verifiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "harm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protected_resources", "forbidden_information_flows"],
          "properties": {
            "protected_resources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
            "forbidden_information_flows": {
              "type": "array",
              "maxItems": 0,
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "x-agentworld-unique-by": "id",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "const": "node-script" },
          "path": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[^\\u0000]+$"
    }
  }
}
