{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JRichlen/agent-plugins/evals/agent-request/schema.json",
  "title": "Portable agent request metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "run_id", "task_id", "action_id", "phase", "context_lane", "reasoning_lane", "model_class", "privacy_class", "capabilities", "approval", "policy_bundle", "issued_at", "expires_at", "nonce", "provenance"],
  "properties": {
    "schema_version": {"const": "agent-request/v1"},
    "agent_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "parent_run_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "action_id": {"$ref": "#/$defs/id"},
    "phase": {"enum": ["plan", "research", "implement", "verify", "review", "publish"]},
    "context_lane": {"enum": ["triage", "normal", "deep", "exclusive"]},
    "reasoning_lane": {"enum": ["low", "medium", "high"]},
    "model_class": {"enum": ["local-general", "local-specialist", "hosted-escalation"]},
    "privacy_class": {"enum": ["public", "internal", "sensitive"]},
    "capabilities": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["scm:read", "filesystem:workspace-read", "filesystem:workspace-write", "sensitive:read", "network:http", "external:publish", "deployment:operate", "host:admin"]}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["state", "action_id", "grant_id"], "properties": {"state": {"enum": ["not-required", "pending", "granted"]}, "action_id": {"$ref": "#/$defs/id"}, "grant_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}}},
    "policy_bundle": {"$ref": "#/$defs/id"},
    "issued_at": {"type": "string", "format": "date-time", "maxLength": 32},
    "expires_at": {"type": "string", "format": "date-time", "maxLength": 32},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["dispatcher_run_id", "sequence"], "properties": {"dispatcher_run_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,63}$"}}
}
